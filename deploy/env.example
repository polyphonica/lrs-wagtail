# Copy to /var/www/lrs/.env (owner lrs, mode 600; never commit the real file). Loaded by lrs.service.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=choir.tywynwebsites.co.uk
SITE_URL=https://choir.tywynwebsites.co.uk
# Postgres through its local socket: the Linux user lrs logs in as the database user lrs, no password.
POSTGRES_DB=lrs
POSTGRES_USER=lrs
POSTGRES_HOST=/var/run/postgresql
MEDIA_ROOT=/var/www/lrs/media
NGINX_SENDFILE=1
LRS_THEME=classic
# Gmail: the account's address and a 16-character app password (needs 2-Step Verification).
# Check with: python manage.py sendtestemail you@example.org
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
