# Copy to /srv/lrs/.env (never commit the real file) and load it from the gunicorn systemd unit.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=www.example.org,example.org
SITE_URL=https://www.example.org
POSTGRES_DB=lrs_wagtail
POSTGRES_USER=lrs_wagtail
POSTGRES_PASSWORD=change-me
MEDIA_ROOT=/srv/lrs/media
NGINX_SENDFILE=1
LRS_THEME=classic
# Gmail: the account's address and a 16-character app password (needs 2-Step Verification).
# Check with: python manage.py sendtestemail you@example.org
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
